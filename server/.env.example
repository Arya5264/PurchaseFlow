# ==============================================================================
# PurchaseFlow Backend Environment Configuration
# ==============================================================================

# Server Port (Local Node development only; unused on Vercel Serverless)
PORT=5000

# MongoDB Connection URI
# Local: mongodb://127.0.0.1:27017/purchaseflow
# Production (MongoDB Atlas): mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/purchaseflow?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/purchaseflow?retryWrites=true&w=majority

# JWT Authentication
# In production, generate a secure random string of 32+ characters
JWT_SECRET=supersecret_purchaseflow_jwt_key_2026_production_academic_secure
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin(s) for CORS (comma-separated if multiple)
# Production example: https://purchaseflow-client.vercel.app
CLIENT_URL=http://localhost:5173,https://purchaseflow-client.vercel.app

# Environment Mode (development | production | test)
NODE_ENV=development
